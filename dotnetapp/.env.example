# Copy this to .env in the dotnetapp folder if you want to use SQL Server.
# If you skip this, the app will use an in-memory database (data resets on restart).

# Example for local SQL Server (Docker):
Connection_String=Server=localhost,1433;Database=FarmConnectDb;User Id=sa;Password=YourStrong@123;TrustServerCertificate=True

# Example for Windows SQL Server Express:
# Connection_String=Server=localhost\\SQLEXPRESS;Database=FarmConnectDb;Trusted_Connection=True;TrustServerCertificate=True
